# Production environment: connect to the PostgreSQL service in the same Compose project.
CRAWLER_API_IMAGE=job-collection-engine/crawler-api:0.2.0-full-e2e-fix.6
POSTGRES_DRIVER=postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=crawler
POSTGRES_USERNAME=crawler
POSTGRES_PASSWORD=replace-with-production-secret-injection
POSTGRES_SSLMODE=disable
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
APP_TIMEZONE=Asia/Shanghai
API_HOST=0.0.0.0
API_PORT=8080
TENANT_ALLOWLIST_PATH=/run/secrets/tenant-allowlist.yml
API_ACCESS_TOKEN_TTL_SECONDS=3600
AGENT_SESSION_TTL_SECONDS=900
LEASE_SECONDS=120
LEASE_RENEWAL_GRACE_SECONDS=30
AGENT_OFFLINE_SECONDS=180
API_TOKEN_HASH_KEY=secret-manager://crawler/api-token-hash
AGENT_DEVICE_CREDENTIAL_HASH_KEY=secret-manager://crawler/agent-device-credential-hash
AGENT_TOKEN_HASH_KEY=secret-manager://crawler/agent-token-hash
CALLBACK_TOKEN_ENCRYPTION_KEY=replace-with-resolved-unpadded-base64url-32-byte-key
CALLBACK_TOKEN_FINGERPRINT_KEY=secret-manager://crawler/callback-token-fingerprint
CALLBACK_TOKEN_ENCRYPTION_KEY_VERSION=v1
WEBHOOK_DISPATCHER_ENABLED=true
WEBHOOK_DISPATCHER_CONCURRENCY=4
WEBHOOK_DISPATCHER_POLL_INTERVAL_SECONDS=1
WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_CLAIM_LEASE_SECONDS=30
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_BASE_SECONDS=5
WEBHOOK_RETRY_MAX_SECONDS=900
WEBHOOK_RETRY_AFTER_MAX_SECONDS=900
WEBHOOK_METRICS_ENABLED=true
